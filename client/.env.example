# API Configuration
REACT_APP_API_URL=http://localhost:5000/api

# Socket.io Configuration
REACT_APP_SOCKET_URL=http://localhost:5000

# App Configuration
REACT_APP_APP_NAME=Video Conference App
REACT_APP_APP_VERSION=1.0.0

# Feature Flags
REACT_APP_ENABLE_RECORDING=true
REACT_APP_ENABLE_WHITEBOARD=true
REACT_APP_ENABLE_FILE_SHARING=true

# Analytics (optional)
# REACT_APP_GOOGLE_ANALYTICS_ID=your-ga-id-here